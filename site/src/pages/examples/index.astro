---
// The examples, as three.js lists its own: one tile per example, its build-time still as the
// cover and its name under it, grouped by category. A tile opens the example's own page.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { copyFor, localePath } from '../../i18n/index.ts';
import { EXAMPLES } from '../../../examples/index.ts';
import { exampleSidebar } from '../../lib/sidebar.ts';

const t = copyFor('en').examples;
const categories = [...new Set(EXAMPLES.map((e) => e.category))];
---

<StarlightPage
  frontmatter={{ title: t.h1, description: t.description, tableOfContents: false, editUrl: false, prev: false, next: false }}
  sidebar={exampleSidebar()}
>
  <p class="text-[16px] leading-[24px] text-fg-2">{t.description}</p>
  {
    categories.map((c) => (
      <section class="not-content mt-10">
        <h2 class="m-0 text-[20px] leading-[30px] font-bold tracking-[-0.2px] text-fg">{c}</h2>
        <ul class="mt-4 mb-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
          {EXAMPLES.filter((e) => e.category === c).map((e) => (
            <li class="m-0 min-w-0">
              <a class="rd-tile block overflow-hidden rounded-[8px] border border-hairline bg-overlay no-underline" href={localePath('en', `/examples/${e.id}/`)}>
                <img class="block aspect-[16/10] w-full bg-black object-cover" src={`/stills/${e.id}.webp`} alt="" loading="lazy" decoding="async" />
                <span class="block border-t border-hairline px-4 pt-3 text-[16px] leading-[24px] font-medium text-fg">{e.title}</span>
                <span class="block px-4 pb-3 text-[14px] leading-[22px] text-fg-2">{e.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</StarlightPage>

<style>
  .rd-tile {
    transition: box-shadow 150ms ease, border-color 150ms ease;
  }
  .rd-tile:hover {
    border-color: transparent;
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.2);
  }
</style>
