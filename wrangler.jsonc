// radiance.typeshade.dev on Cloudflare Workers: the library site (site/, built into dist/site by
// `bun run site`) served as static assets, with no Worker code. It sits beside typeshade.dev
// and gallery.typeshade.dev in the same account, as typeshade.github.io's wrangler files set
// them up (docs/cloudflare.md there). `.github/workflows/deploy.yml` deploys it from `main`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radiance-demo",
  // Not a secret: the account typeshade.dev is in. CI needs one secret, CLOUDFLARE_API_TOKEN.
  "account_id": "7c029c2ac777ff3c45a4bcbe67918a1e",
  "compatibility_date": "2026-09-01",
  // The site answers at its own address only, not at a second workers.dev copy.
  "workers_dev": false,
  "routes": [{ "pattern": "radiance.typeshade.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist/site",
    "not_found_handling": "404-page",
  },
}
