{
  "name": "radiance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "TypeShade Radiance: a reproducible, differentiable path-tracing renderer for the web.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync": "bun vendor/typeshade/src/cli/bin.ts sync packages",
    "typecheck": "bun run sync && tsc -p tsconfig.json",
    "check:shaders": "bun vendor/typeshade/src/cli/bin.ts check packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:prose": "node scripts/check-prose.mjs",
    "check:boundary": "node scripts/boundary.mjs",
    "bake:api-surface": "bun scripts/bake-api-surface.ts",
    "gate:api": "bun scripts/gates/api.mjs",
    "check:ste": "node scripts/check-ste.mjs",
    "reqs:sync": "bun scripts/reqs-sync.ts",
    "reqs:check": "bun scripts/reqs-sync.ts --check",
    "test": "bun test scripts packages",
    "harness": "node scripts/harness.mjs",
    "check": "bun run format:check && bun run check:prose && bun run check:ste && bun run check:boundary && bun run gate:api && bun run check:shaders && bun run typecheck && bun run test",
    "site": "bun run sync && cd site && bun --bun astro build",
    "site:dev": "bun run sync && cd site && bun --bun astro dev",
    "capture:stills": "STILLS_REBASELINE=1 bun run site && node scripts/capture-stills.mjs"
  },
  "dependencies": {
    "typeshade": "file:./vendor/typeshade"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typeshade/radiance": "workspace:*",
    "@typeshade/radiance-addons": "workspace:*",
    "antd": "^6.6.5",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "lucide-react": "^1.52.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.59.1",
    "pretendard": "^1.3.9",
    "prettier": "^3.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0",
    "starlight-typedoc": "^0.23.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "5.6.3",
    "wrangler": "^4.142.0"
  }
}
